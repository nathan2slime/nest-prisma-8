// use prisma-8
model Product {
  id          String @id @default(cuid(2))

  name        String
  description String

  createdAt   Date   @default(now())

  brand       Brand  @relation(fields: [brandId], references: [id])
  brandId     String

  @@map("products")
}

model SkuProduct {
  id         String  @id @default(cuid(2))

  skuId      Int
  price      Int
  amount     Int

  product    Product @relation(fields: [productId], references: [id])
  productId  String

  atributtes Json

  @@map("product_skus")
}

model Brand {
  id        String @id @default(cuid(2))

  name      String
  createdAt Date   @default(now())

  @@map("brands")
}
